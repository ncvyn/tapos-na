---
import "../styles/global.css";
import DayView from "../components/DayView";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tapos-na — pomodoro calendar</title>
  </head>
  <body class="min-h-dvh bg-base-200 text-base-content">
    <header class="navbar bg-base-100 shadow-sm">
      <div class="navbar-start">
        <span class="text-lg font-semibold">tapos-na</span>
      </div>
      <div class="navbar-end">
        <span class="badge badge-soft badge-primary">T2 Day UI</span>
      </div>
    </header>
    <main class="mx-auto max-w-6xl p-4 sm:p-6">
      <DayView client:load />
    </main>
  </body>
</html>
